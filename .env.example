# =============================================================================
# Speech-to-Text — Environment configuration template
# =============================================================================
# Copy this file to `.env` at the repository root and fill in every REQUIRED
# variable:
#
#     cp .env.example .env        (Linux / macOS / Git Bash)
#     copy .env.example .env      (Windows)
#
# The `.env` file is GIT-IGNORED: never commit, never publish it.
#
# Configuration policy of this repository:
#   * Tuned hyperparameters, the CTC blank-penalty tier matrix, and logic
#     toggles have NO defaults in the code. Configuration loading fails fast
#     with `MissingEnvironmentError` until the matrix is provided.
#   * Optional infrastructure variables (paths, device, workers) fall back
#     to the safe defaults shown below.
#   * No extra dependency is needed: `src/utils/env.py` parses the file.
#   * Booleans: true/false/1/0/yes/no/on/off. Scientific notation (e.g. 5e-4)
#     is accepted for floats.
# =============================================================================


# -----------------------------------------------------------------------------
# Model architecture                                 [REQUIRED — no defaults]
# Memory-tuned CNN/RNN encoder configuration.
# -----------------------------------------------------------------------------
STT_MODEL_N_CNN_LAYERS=
STT_MODEL_N_RNN_LAYERS=
STT_MODEL_RNN_DIM=
STT_MODEL_N_FEATS=
STT_MODEL_DROPOUT=
STT_MODEL_USE_ATTENTION=
STT_MODEL_N_ATTENTION_HEADS=
STT_MODEL_USE_TRANSFORMER=
STT_MODEL_USE_SE=
STT_MODEL_USE_CHUNKED_ATTENTION=
STT_MODEL_ATTENTION_CHUNK_SIZE=
STT_MODEL_ATTENTION_OVERLAP=


# -----------------------------------------------------------------------------
# Training schedule                                   [REQUIRED — no defaults]
# Optimizer, LR schedule, and checkpointing cadence.
# STT_TRAIN_SCHEDULER_TYPE: onecycle | cosine | step | none
# -----------------------------------------------------------------------------
STT_TRAIN_BATCH_SIZE=
STT_TRAIN_EPOCHS=
STT_TRAIN_LEARNING_RATE=
STT_TRAIN_MAX_LR=
STT_TRAIN_WEIGHT_DECAY=
STT_TRAIN_GRADIENT_ACCUMULATION_STEPS=
STT_TRAIN_WARMUP_STEPS=
STT_TRAIN_SCHEDULER_TYPE=
STT_TRAIN_EARLY_STOPPING_PATIENCE=
STT_TRAIN_VALIDATE_EVERY=
STT_TRAIN_SAVE_EVERY=


# -----------------------------------------------------------------------------
# CTC blank-penalty matrix                            [REQUIRED — no defaults]
# Tiered adaptive penalty that counters CTC blank-token collapse.
#
# STT_BLANK_PENALTY_TIERS format:
#   threshold:exponent:multiplier segments, comma-separated, with strictly
#   ascending thresholds (synthetic example): 0.0:1:1.0,0.5:2:2.0
# For each sample, the highest tier whose threshold is exceeded by the
# average blank probability supplies probability^exponent * multiplier.
# -----------------------------------------------------------------------------
STT_BLANK_PENALTY_WEIGHT=
STT_BLANK_PENALTY_TIERS=


# -----------------------------------------------------------------------------
# Data pipeline                                       [REQUIRED — no defaults]
# STT_DATA_DATASET_TYPE: custom | librispeech
# -----------------------------------------------------------------------------
STT_DATA_DATASET_TYPE=
STT_DATA_INCLUDE_PERSIAN=
STT_DATA_TRAIN_SPLIT=
STT_DATA_N_MELS=
STT_DATA_FREQ_MASK_PARAM=
STT_DATA_TIME_MASK_PARAM=
STT_DATA_NUM_FREQ_MASKS=
STT_DATA_NUM_TIME_MASKS=


# -----------------------------------------------------------------------------
# Optional infrastructure                [OPTIONAL — safe defaults provided]
# -----------------------------------------------------------------------------
# STT_TRAIN_MAX_GRAD_NORM=1.0
# STT_TRAIN_USE_AMP=true
# STT_TRAIN_NUM_WORKERS=2
# STT_TRAIN_PIN_MEMORY=true
# STT_DATA_SAMPLE_RATE=16000
# STT_DATA_AUDIO_FILES_DIR=dataset/audio_files
# STT_DATA_TRANSCRIPTS_DIR=dataset/info
# STT_DATA_TEST_AUDIO_DIR=dataset/test_audio
# STT_DATA_TRAIN_ROOT=/kaggle/input/librispeech-clean
# STT_DATA_TEST_ROOT=/kaggle/input/librispeech-clean
# STT_CHECKPOINT_DIR=checkpoints
# STT_LOG_DIR=logs
# STT_DEVICE=cuda
# STT_SEED=42
